{
	"$schema": "https://raw.githubusercontent.com/ateeducacion/nextcloud-playground/main/assets/blueprints/blueprint-schema.json",
	"meta": {
		"title": "Tasks Board Playground",
		"author": "Sven Würth",
		"description": "A fresh Nextcloud in the browser with the latest release of Tasks Board installed. Nothing is stored on a server; closing the tab starts over."
	},
	"landingPage": "/index.php/apps/tasks_board/",
	"siteOptions": {
		"title": "Tasks Board",
		"locale": "en",
		"timezone": "UTC"
	},
	"admin": {
		"username": "admin",
		"password": "admin",
		"email": "admin@example.com"
	},
	"steps": [
		{ "step": "disableApp", "app": "firstrunwizard" },
		{
			"step": "installApp",
			"appId": "tasks_board",
			"url": "https://github-proxy.exelearning.dev/?repo=its-sven/Tasks-Board&release=latest&asset=tasks_board.tar.gz"
		}
	]
}
